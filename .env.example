# ─── Site ─────────────────────────────────────────────────────────────────────
# Canonical production URL (used for SEO: sitemap, robots, Open Graph).
# Optional locally — falls back to the placeholder domain in lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://manishabhardwaj.example

# Google Search Console verification token (Settings → Ownership verification →
# HTML tag). Paste just the content="..." value here to verify the site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Contact form (Gmail SMTP via nodemailer) ─────────────────────────────────
# EMAIL_APP_PASSWORD is a Google "App Password", not the account password.
# Create one at: https://myaccount.google.com/apppasswords
# Without these the form returns a 503 instead of silently failing.
EMAIL_USER=mb02bhardwaj@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# ─── WhatsApp click-to-chat (optional) ────────────────────────────────────────
# Full international number, digits only — country code first, no +, spaces or
# dashes. e.g. India 98765 43210 -> 919876543210
# Leave empty and the WhatsApp button is hidden everywhere.
NEXT_PUBLIC_WHATSAPP_NUMBER=
